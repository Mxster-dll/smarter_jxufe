<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 小组件周期刷新任务需要「重启后自动恢复」（JobInfo.setPersisted） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="智慧er江财"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 定时通知（截止提醒）：flutter_local_notifications 自 v16 起插件清单只声明
             POST_NOTIFICATIONS / VIBRATE，投递定时通知的 receiver 必须由 App 自己声明，
             否则排期到点**静默不触发**；Boot 版负责重启后重新排期（权限见文件顶部
             RECEIVE_BOOT_COMPLETED）。 -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- 「导出文件 + 调起系统分享」：自研 FileShareBridge 把文件写到
             cacheDir/shared/ 后用 FileProvider 暴露为 content:// 交给 ACTION_SEND。
             exported=false + grantUriPermissions=true：仅本应用可发起，接收方按次授权。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 桌面小组件：数据一览 / 电费余额 / 课程加权，各 8 档尺寸
             （2×1 / 3×1 / 4×1 / 5×1 / 2×2 / 3×2 / 4×2 / 5×2）＝ 24 个独立 receiver。
             每档一个独立 receiver —— 桌面（尤其华为/HarmonyOS）不保证支持缩放，
             拆成多档时用户在添加面板里能直接选到想要的尺寸。
             exported=false：APPWIDGET_UPDATE 由系统（system uid）显式下发，
             非导出接收器同样能收到，避免第三方应用伪造刷新广播。 -->
        <receiver
            android:name=".widget.ElectricityWidget2x1"
            android:exported="false"
            android:label="@string/home_widget_electricity_2x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
