<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件卡片底：圆角 16dp + 细描边；颜色走 @color，深色模式自动切换 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/home_widget_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/home_widget_stroke" />
</shape>
