<?xml version="1.0" encoding="utf-8"?>
<!-- 文档说明：dashboard 小组件 4×1 档（宽 × 高 = 4 × 1 格）。
     minWidth/minHeight 用 cells*70-30 换算（兼容 API 31 以下的桌面），
     targetCellWidth/targetCellHeight 供 API 31+ 精确定位。
     initialLayout/previewLayout 指向 home_widget_dashboard_4x1。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_dashboard_4x1_desc"
    android:initialLayout="@layout/home_widget_dashboard_4x1"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/home_widget_dashboard_4x1"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
